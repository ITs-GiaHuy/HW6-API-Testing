          "script": {
            "type": "text/javascript",
            "exec": [
              "// Create a JWT-like token with SQLi in the payload",
              "// This tests if the server is vulnerable to SQLi through JWT payload",
              "const header = btoa(JSON.stringify({alg: 'HS256', typ: 'JWT'}));",
              "const payload = btoa(JSON.stringify({id: \"1' OR 1=1 --\", role: 'user'}));",
              "const fakeToken = header + '.' + payload + '.invalidsignature';",
              "pm.variables.set('sqli_token', fakeToken);"
            ]
          }
        }
